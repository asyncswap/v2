# Copy this file to .env.deploy and fill in the private RPC URL and keystore account.
# Keep .env.deploy local; it is ignored by git.
# Generic RPC; a chain-specific variable from script/config/chains.json (rpcUrlEnv, e.g. RPC_URL_ARC)
# takes precedence when set, so one file can hold several chains.
RPC_URL=https://your-unichain-rpc.example
# RPC_URL_ARC=https://rpc.mainnet.arc.io
DEPLOYER_ACCOUNT=asyncswap-production
# Optional. Owner/deployer address. Broadcasts read it from the keystore when unset; dry runs
# fall back to the script default, which changes the mined hook salt.
# DEPLOY_OWNER=0x...
# Optional. The wrapper deploys AsyncMatching deterministically (CREATE2) when this is unset or zero.
# Set it only to link a library deployed some other way.
ASYNC_MATCHING_LIBRARY_ADDRESS=0x0000000000000000000000000000000000000000
# Chain-specific contract addresses, including USDC, are read from
# script/config/chains.json. Do not copy them into this file.

# Optional. Leave unset to have the deploy script mine a valid CREATE2 salt.
# HOOK_SALT=0x...

# Optional verification key; only needed for source verification after deployment.
# ETHERSCAN_API_KEY=

# Pool initialization inputs (only needed when initializing a new pool after deploy).
# TOKEN_IN=ETH
# TOKEN_OUT=USDC
# INIT_SQRT_PRICE_X96=<required; see DEPLOYMENT.md>
# POOL_FEE=8388608
# POOL_TICK_SPACING=60
